    local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
    local gameplay = remotes and remotes:WaitForChild("Gameplay", 10)
    if not farm.alive then return end
    local function listen(name, callback)
        local event = gameplay and gameplay:FindFirstChild(name)
        if event and event:IsA("RemoteEvent") then connect(event.OnClientEvent, callback) end
    end
    listen("RoundStart", function(_, roles)
        resetRound(true, type(roles) == "table" and roles or nil)
    end)
    listen("CoinsStarted", function()
        table.clear(farm.bags)
        table.clear(farm.retry)
        if farm.enabled then indexCoins() end
    end)
    for _, name in ipairs({"LoadingMap", "VictoryScreen", "GameOver", "RoundEndFade"}) do
        listen(name, function() resetRound(false) end)
    end
    listen("PlayerDataChanged", function(roles)
        if type(roles) ~= "table" then return end
        if next(roles) == nil then
            resetRound(false)
        else
            farm.roles = roles
        end
    end)
    listen("CoinCollected", function(kind, first, second)
        if type(kind) ~= "string" or kind == "" then return end
        local count, limit = tonumber(first), tonumber(second)
        if count and limit and limit > 0 then farm.bags[kind] = {count = count, limit = limit} end
        local contact = farm.contact
        if farm.enabled and contact and contact.kind == kind and os.clock() - contact.time < 1.5 then
            farm.retry[contact.coin] = math.huge
            farm.contact = nil
            farm.total += 1
        end
    end)
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local roundModule = modules and modules:FindFirstChild("CurrentRoundClient")
    if roundModule and roundModule:IsA("ModuleScript") then
        local ok, round = pcall(require, roundModule)
        if farm.alive and farm.roundActive == nil and farm.roles == nil
            and ok and type(round) == "table" and type(round.PlayerData) == "table" then
            farm.roles = round.PlayerData
        end
    end
end)

local function nearestCoin(root)
    local nearest, distance = nil, math.huge
    local now = os.clock()
    local full = {}
    for coin in pairs(farm.coins) do
        local kind = currency(coin)
        if kind and full[kind] == nil then full[kind] = bagFull(kind) == true end
        if kind and not full[kind] and (farm.retry[coin] or 0) <= now and available(coin) then
            local current = (coin.Position - root.Position).Magnitude
            if current < distance then nearest, distance = coin, current end
        end
    end
    return nearest
end

local function collect(character, root, humanoid, coin)
    local generation = farm.generation
    local kind = currency(coin)
    local function valid()
        return farm.alive and farm.enabled and farm.generation == generation
            and player.Character == character and root.Parent == character and humanoid.Health > 0
            and inRound() and not bagFull(kind) and available(coin)
    end
    if not valid() then return end
    if farm.position == "Under" and type(firetouchinterest) ~= "function" then
        status("Under mode requires touch support")
        return
    end

    local target, surface = coin.Position, nil
    if farm.position == "Under" then
        target, surface = underTarget(character, root, coin)
        if not target then
            farm.retry[coin] = os.clock() + 2
            status("Waiting for floor below " .. kind:lower())
            return
        end
    end
    local travel = beginTravel(character, root, humanoid)

    status("Collecting " .. kind:lower())
    if farm.mode == "Tween" then
        local duration = math.max((target - root.Position).Magnitude / farm.speed, 0.02)
        travel.tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(target)})
        travel.tween:Play()
        while valid() and travel.tween.PlaybackState == Enum.PlaybackState.Playing do
            RunService.Heartbeat:Wait()
            if farm.travel == travel then travel.lastPosition = root.Position end
        end
    else
        local deadline = os.clock() + (target - root.Position).Magnitude / farm.speed + 3
        while valid() and os.clock() < deadline do
            local dt = RunService.Heartbeat:Wait()
            if not valid() then break end
            local delta = target - root.Position
            if delta.Magnitude <= 2.25 then break end
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.new(root.Position + delta.Unit * math.min(delta.Magnitude, farm.speed * math.min(dt, 0.12)))
            travel.lastPosition = root.Position
        end
    end
    if farm.travel ~= travel then return end
    stopTween(travel)
    if valid() and (target - root.Position).Magnitude <= 3 then
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = CFrame.new(target)
        travel.lastPosition = target
        if surface then travel.surface = surface end
        farm.contact = {coin = coin, kind = kind, time = os.clock()}
        for _ = 1, 2 do
            if not valid() or not farm.contact then break end
            root.CFrame = CFrame.new(target)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            if type(firetouchinterest) == "function" then
                local head = character:FindFirstChild("Head")
                for _, part in ipairs({root, head}) do
                    if part:IsA("BasePart") then
                        pcall(firetouchinterest, part, coin, 0)
                        pcall(firetouchinterest, part, coin, 1)
                    end
                end
            end
            task.wait(0.3)
        end
        if farm.generation == generation and (farm.retry[coin] or 0) < math.huge then
            farm.retry[coin] = os.clock() + 1.5
        end
    elseif valid() then
        farm.retry[coin] = os.clock() + 2
    end
end

local function fullBag()
    for kind in pairs(farm.bags) do
        if bagFull(kind) then return true end
    end
    local container = bagContainer()
    if container then
        for _, bag in ipairs(container:GetChildren()) do
            if bag:IsA("GuiObject") and bag.Visible and bagFull(bag.Name) then return true end
        end
    end
    return false
end

local function roundTarget(root, wantMurderer)
    local nearest, distance = nil, math.huge
    for _, target in ipairs(Players:GetPlayers()) do
        local data = playerRoundData(target)
        local character = target.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local targetRoot = character and character:FindFirstChild("HumanoidRootPart")
        if target ~= player and type(data) == "table" and data.Dead ~= true
            and ((wantMurderer and data.Role == "Murderer")
                or (not wantMurderer and (data.Role == "Innocent" or data.Role == "Sheriff" or data.Role == "Hero")))
            and humanoid and humanoid.Health > 0 and targetRoot and targetRoot:IsA("BasePart") then
            local gap = (targetRoot.Position - root.Position).Magnitude
            if gap < distance then nearest, distance = targetRoot, gap end
        end
    end
    return nearest
end

local function equip(character, humanoid, name)
    local backpack = player:FindFirstChildOfClass("Backpack")
    local tool = character:FindFirstChild(name) or (backpack and backpack:FindFirstChild(name))
    if not tool or not tool:IsA("Tool") then return end
    if tool.Parent ~= character then
        humanoid:EquipTool(tool)
        task.wait(0.15)
    end
    if tool.Parent == character then return tool end
end

local function endingValid(request, character, humanoid)
    return farm.alive and farm.enabled and farm.autoEndRound and farm.endRequest == request
        and farm.roundActive ~= false and player.Character == character and humanoid.Health > 0
end

local function endRoundAction(request, character, root, humanoid)
    local knife = not request.died and request.role == "Murderer"
    local gun = not request.died and (request.role == "Sheriff" or request.role == "Hero")
    local target = roundTarget(root, not knife)
    if not target then return end
    if knife then
        local tool = equip(character, humanoid, "Knife")
        if not tool or not endingValid(request, character, humanoid) or not target.Parent then return end
        local stab = tool:FindFirstChild("Stab")
        local events = tool:FindFirstChild("Events")
        local stabbed = events and events:FindFirstChild("KnifeStabbed")
        root.CFrame = target.CFrame * CFrame.new(0, 0, 2)
        tool:Activate()
        if stab and stab:IsA("RemoteEvent") then stab:FireServer("Slash")
        elseif stabbed and stabbed:IsA("RemoteEvent") then stabbed:FireServer() end
    elseif gun then
        local tool = equip(character, humanoid, "Gun")
        if not tool or not endingValid(request, character, humanoid) or not target.Parent then return end
        local shoot = tool:FindFirstChild("Shoot", true)
        if shoot and shoot:IsA("RemoteEvent") then
            local position = target.Position
            shoot:FireServer(CFrame.new(position + Vector3.new(0, 1.2, 0)), CFrame.new(position))
        end
    else
        local origin = root.CFrame
        local deadline = os.clock() + 0.45
        local ok, err = pcall(function()
            while endingValid(request, character, humanoid) and target.Parent and os.clock() < deadline do
                root.CFrame = target.CFrame * CFrame.new(0, 0.5, 0)
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.new(10000, 10000, 10000)
                RunService.Heartbeat:Wait()
            end
        end)
        if root.Parent == character then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            if farm.roundActive ~= false and farm.roundSerial == request.roundSerial and humanoid.Health > 0 then
                root.CFrame = origin
            end
        end
        if not ok then error(err) end
    end
end

local function endRoundStep(character, root, humanoid, playing)
    local own = playerRoundData(player)
    if playing then
        farm.wasPlaying = true
        farm.playingCharacter = character
        farm.lastRole = type(own) == "table" and own.Role or farm.lastRole
    end
    if not farm.autoEndRound or farm.roundActive == false then return false end

    local died = farm.wasPlaying and not playing
        and (character == nil or (type(own) == "table" and own.Dead == true))
    local request = farm.endRequest
    if not request then
        if not died and (not playing or not fullBag()) then return false end
        cancel()
        request = {role = farm.lastRole, died = died, attempts = 0, nextAt = 0, roundSerial = farm.roundSerial}
        if died then request.deadCharacter = farm.playingCharacter end
        farm.endRequest = request
    elseif died and not request.died then
        request.died = true
        request.deadCharacter = farm.playingCharacter
        request.attempts = 0
        request.nextAt = 0
    end

    if not character or (request.died and character == request.deadCharacter) then
        status("Waiting for respawn to end round")
        return true
    end
    if request.role ~= "Murderer" and request.role ~= "Sheriff"
        and request.role ~= "Hero" and request.role ~= "Innocent" then
        status("Waiting for this mode to end")
        return true
    end
    local maxAttempts = request.role == "Murderer" and not request.died and 8 or 3
    if request.attempts >= maxAttempts then
        status("Waiting for round result")
        return true
    end
    if os.clock() >= request.nextAt then
        request.attempts += 1
        request.nextAt = os.clock() + 1.2
        status("Ending round")
        local ok, err = pcall(endRoundAction, request, character, root, humanoid)
        if not ok then warn("[DxckkyPray] " .. tostring(err)) end
    end
    return true
end

