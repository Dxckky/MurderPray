local function status(message)
    local description = message .. "\nCollected: " .. farm.total
    if description ~= farm.status then
        farm.status = description
        statusLabel:SetDesc(description)
    end
end

local function connect(signal, callback)
    table.insert(farm.connections, signal:Connect(callback))
end

local function updateRendering()
    local reduce = farm.alive and farm.enabled and farm.reduceRendering
    if reduce and farm.previousRendering == nil then
        local readOk, enabled = pcall(function()
            return RunService:Is3dRenderingEnabled()
        end)
        local setOk = pcall(function()
            RunService:Set3dRenderingEnabled(false)
        end)
        if setOk then
            farm.previousRendering = not readOk or enabled ~= false
        else
            WindUI:Notify({
                Title = "Reduce 3D Rendering",
                Content = "3D rendering controls are unavailable in this executor.",
                Duration = 3,
            })
        end
    elseif not reduce and farm.previousRendering ~= nil then
        local restored = pcall(function()
            RunService:Set3dRenderingEnabled(farm.previousRendering)
        end)
        if restored then farm.previousRendering = nil end
    end
end

