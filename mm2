    Title = "Auto End Round After Full Bag or Death", Value = false,
    Callback = function(value)
        farm.autoEndRound = value == true
        if not farm.autoEndRound then farm.endRequest = nil end
    end,
})
tab:Toggle({
    Title = "Reduce 3D Rendering", Value = false, Desc = "Pause 3D rendering during Auto Coin Farm.",
    Callback = function(value)
        farm.reduceRendering = value == true
        updateRendering()
    end,
})
tab:Button({
    Title = "Hide Menu", Desc = "Reopen with Open DxckkyPray or Right Shift.",
    Callback = function() window:Close() end,
})

function farm:destroy(windowAlreadyDestroyed)
    if not self.alive then return end
    self.alive = false
    self.enabled = false
    cancel()
    updateRendering()
    for _, connection in ipairs(self.connections) do connection:Disconnect() end
    if env[runtimeKey] == self then env[runtimeKey] = nil end
    if not windowAlreadyDestroyed and type(window.Destroy) == "function" then window:Destroy() end
end

if type(window.OnDestroy) == "function" then
    window:OnDestroy(function() farm:destroy(true) end)
end

task.spawn(function()
    while farm.alive do
        if farm.enabled then
            local character, root, humanoid = characterParts()
            local playing = character ~= nil and inRound()
            if endRoundStep(character, root, humanoid, playing) then
                -- Let the end-round action finish before resuming coin movement.
            elseif not playing then
                stopTravel()
                status("Waiting for round")
            else
                local coin = nearestCoin(root)
                if coin then
                    local ok, err = pcall(collect, character, root, humanoid, coin)
                    if not ok then
                        cancel()
                        farm.retry[coin] = os.clock() + 5
                        status("Coin collection failed")
                        warn("[DxckkyPray] " .. tostring(err))
                    end
                elseif fullBag() then
                    stopTravel()
                    status("Bag full - waiting for next round")
                else
                    if farm.position ~= "Under" then stopTravel() end
                    status("Waiting for coins")
                end
            end
        end
        task.wait(0.2)
    end
end)
