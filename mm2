end)

local function bagContainer()
    local gui = player:FindFirstChildOfClass("PlayerGui")
    local main = gui and gui:FindFirstChild("MainGUI")
    local gameGui = main and main:FindFirstChild("Game")
    local bags = gameGui and gameGui:FindFirstChild("CoinBags")
    return bags and bags:FindFirstChild("Container")
end

local function currency(coin)
    local visual = coin:FindFirstChild("CoinVisual")
    local id = coin:GetAttribute("CoinID") or (visual and visual:GetAttribute("CoinID"))
    if type(id) == "string" and id ~= "" then return id end
    local kind = coin.Name:match("^(.+)_Server$")
    if kind then
        local container = bagContainer()
        if kind == "Coin" or kind == "Candy" or (container and container:FindFirstChild(kind)) then
            return kind
        end
    end
end

local function track(part)
    if not farm.enabled or not part:IsA("BasePart") then return end
    local coin = part
    if part.Name == "CoinVisual" or CollectionService:HasTag(part, "CoinVisual") then
        local parent = part.Parent
        if parent and parent:IsA("BasePart") and parent.Name:match("_Server$") then
            coin = parent
            farm.coins[part] = nil
        end
    elseif not part.Name:match("_Server$") then
        return
    end
    if currency(coin) then
        farm.coins[coin] = true
    end
end

local function indexCoins()
    for _, part in ipairs(workspace:GetDescendants()) do track(part) end
end

local function visiblePart(part)
    return part:IsA("BasePart") and part.Transparency < 0.99
        and part.LocalTransparencyModifier < 0.99
end

local function available(coin)
    if not coin:IsDescendantOf(workspace) or coin:GetAttribute("Collected") == true
        or coin:GetAttribute("Delete") == true or coin:GetAttribute("RoundEnd") == true then
        return false
    end
    local lobby = workspace:FindFirstChild("Lobby")
    if lobby and coin:IsDescendantOf(lobby) then return false end
    local visual = coin:FindFirstChild("CoinVisual")
    if not visual and CollectionService:HasTag(coin, "CoinVisual") then visual = coin end
    if not visual then return true end
    if visual:GetAttribute("Collected") == true then return false end
    if visiblePart(visual) then return true end
    for _, part in ipairs(visual:GetDescendants()) do
        if visiblePart(part) then return true end
    end
    return false
end

local function bagFor(kind)
    local container = bagContainer()
    return container and container:FindFirstChild(kind)
end

local function bagFull(kind)
    local data = farm.bags[kind]
    if data and data.limit and data.count >= data.limit then return true end
    local bag = bagFor(kind)
    local full = bag and bag:FindFirstChild("Full")
    return bag and bag:IsA("GuiObject") and bag.Visible
        and full and full:IsA("GuiObject") and full.Visible
end

local function playerRoundData(target)
    local roles = farm.roles
    return roles and (roles[target.Name] or roles[tostring(target.UserId)] or roles[target.UserId])
end

local function inRound()
    if farm.roundActive == false then return false end
    local own = playerRoundData(player)
    if type(own) == "table" then
        return own.Dead ~= true and own.Role ~= "Spectator" and own.Role ~= "Lobby"
    end
    if farm.roles and next(farm.roles) ~= nil then return false end
    local container = bagContainer()
    if container then
        for _, bag in ipairs(container:GetChildren()) do
            if bag:IsA("GuiObject") and bag.Visible then return true end
        end
    end
    return false
end

local function characterParts()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart")
        and character:IsDescendantOf(workspace) then
        return character, root, humanoid
    end
end

local function stopTween(travel)
    if travel.tween then
        travel.tween:Cancel()
        travel.tween:Destroy()
        travel.tween = nil
    end
end

local function stopTravel()
    local travel = farm.travel
    if not travel then return end
    farm.travel = nil
    stopTween(travel)
    if travel.added then travel.added:Disconnect() end
    if travel.physics then travel.physics:Disconnect() end
    if travel.under and travel.root.Parent == player.Character
        and travel.humanoid.Health > 0
        and (travel.root.Position - travel.lastPosition).Magnitude <= 12 then
        travel.root.CFrame = travel.surface
        travel.root.AssemblyLinearVelocity = Vector3.zero
        travel.root.AssemblyAngularVelocity = Vector3.zero
    end
    if travel.stabilizer then travel.stabilizer:Destroy() end
    for part, original in pairs(travel.parts) do
        if part.Parent then
            part.CanCollide = original.collide
            if original.massless ~= nil then part.Massless = original.massless end
        end
    end
end

local function beginTravel(character, root, humanoid)
    local travel = farm.travel
    local under = farm.position == "Under"
    if travel and travel.root == root and travel.under == under then return travel end
    stopTravel()
    travel = {
        root = root, humanoid = humanoid, under = under, parts = {},
        lastPosition = root.Position, surface = root.CFrame,
    }
    farm.travel = travel

    local function trackPart(part)
        if not part:IsA("BasePart") or travel.parts[part] then return end
        local original = {collide = part.CanCollide}
        if part:FindFirstAncestorWhichIsA("Tool") then original.massless = part.Massless end
        travel.parts[part] = original
        part.CanCollide = false
        if original.massless ~= nil then part.Massless = true end
    end
    for _, part in ipairs(character:GetDescendants()) do trackPart(part) end
    travel.added = character.DescendantAdded:Connect(trackPart)
    travel.physics = RunService.PreSimulation:Connect(function()
        for part, original in pairs(travel.parts) do
            if part:IsDescendantOf(character) then
                if part.CanCollide then part.CanCollide = false end
                if original.massless ~= nil and not part.Massless then part.Massless = true end
            else
                if part.Parent then
                    part.CanCollide = original.collide
                    if original.massless ~= nil then part.Massless = original.massless end
                end
                travel.parts[part] = nil
            end
        end
    end)
    if under then
        local support = Instance.new("BodyVelocity")
        support.Name = "DxckkyPrayCoinStabilizer"
        support.Velocity = Vector3.zero
        support.MaxForce = Vector3.new(0, 9e9, 0)
        support.P = 90000
        support.Parent = root
        travel.stabilizer = support
    end
    return travel
end

local function underTarget(character, root, coin)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character, coin}
    params.RespectCanCollide = true
    local origin = coin.Position - Vector3.new(0, coin.Size.Y / 2 + 0.05, 0)
    local floor = workspace:Raycast(origin, Vector3.new(0, -20, 0), params)
        or workspace:Raycast(coin.Position + Vector3.new(0, 0.2, 0), Vector3.new(0, -24, 0), params)
    if not floor then return end

    local underside = floor.Position.Y
    local part = floor.Instance
    if part:IsA("BasePart") then
        -- Probe upward through only the floor we hit, so a thick slab uses its lower face.
        local up = RaycastParams.new()
        up.FilterType = Enum.RaycastFilterType.Include
        up.FilterDescendantsInstances = {part}
        up.RespectCanCollide = true
        local size, frame = part.Size, part.CFrame
        local halfHeight = (math.abs(frame.RightVector.Y) * size.X
            + math.abs(frame.UpVector.Y) * size.Y + math.abs(frame.LookVector.Y) * size.Z) / 2
        local bottom = part.Position.Y - halfHeight
        local depth = floor.Position.Y - bottom + 0.5
        if depth > 0 and depth <= 64 then
            local hit = workspace:Raycast(floor.Position - Vector3.new(0, depth, 0), Vector3.new(0, depth + 1, 0), up)
            if hit then underside = hit.Position.Y end
        end
    end
    local head = character:FindFirstChild("Head")
    local topOffset = head and head:IsA("BasePart") and head.Position.Y + head.Size.Y / 2 - root.Position.Y or 2
    local target = Vector3.new(coin.Position.X, underside - math.clamp(topOffset, 1, 5) - 1.5, coin.Position.Z)
    local surface = CFrame.new(coin.Position + Vector3.new(0, 2, 0))
    return target, surface
end

local function cancel()
    farm.generation += 1
    stopTravel()
end

local function resetRound(active, roles)
    cancel()
    farm.roundActive = active
    farm.roles = roles
    farm.roundSerial = (farm.roundSerial or 0) + 1
    farm.endRequest = nil
    farm.wasPlaying = false
    farm.lastRole = nil
    farm.playingCharacter = nil
    table.clear(farm.bags)
    table.clear(farm.retry)
    farm.contact = nil
end

